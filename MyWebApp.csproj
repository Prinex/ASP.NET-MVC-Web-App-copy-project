<Project Sdk="Microsoft.NET.Sdk.Web">
  
  <PropertyGroup>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <IsPublishable>true</IsPublishable>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'https' " />
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'http' " />
  
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Blazor.Bootstrap" Version="4.0.0" />
    <PackageReference Include="dotenv.net" Version="4.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Mailjet.Api" Version="4.0.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.0" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.0" />
    <PackageReference Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="ServiceStack.Interfaces" Version="10.4.0" />
    <PackageReference Include="NLipsum" Version="1.1.0" />
    <PackageReference Include="CloudinaryDotNet" Version="1.29.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Components\Shared\" />
    <Folder Include="Models\" />
    <Folder Include="wwwroot\css\" />
    <Folder Include="wwwroot\js\About\" />
    <Folder Include="wwwroot\js\Contact\" />
    <Folder Include="wwwroot\js\Projects\" />
  </ItemGroup>

  <ItemGroup>
    <RazorComponent Include="Components\**\*.razor" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest"></Content>
  </ItemGroup>                             
                              
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest"></Content>
  </ItemGroup>                             
                              
  <ItemGroup>
    <Compile Remove="Migrations\**" />
    <EmbeddedResource Remove="Migrations\**" />
    <None Remove="Migrations\**" />
  </ItemGroup>
  
  <ItemGroup>
    <None Remove="wwwroot\js\utils.js" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Pages\Error.cshtml" />
  </ItemGroup>
  
  <Target Name="CustomCollectFiles" AfterTargets="Publish"> 
    <ItemGroup> 
      <AllContentFiles Include="Views\**\*.cshtml" /> 
    </ItemGroup> 
    <Copy SourceFiles="@(AllContentFiles)" DestinationFolder="$(PublishDir)\%(RelativeDir)" />
  </Target>
  
</Project>
